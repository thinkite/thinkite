---
import BrandMark from "./BrandMark.astro";
import { links } from "../config";
---

<nav class="nav">
  <div class="wrap nav-inner">
    <a class="brand" href="/#top" aria-label="Thinkite home">
      <BrandMark />
      Thinkite
    </a>

    <div class="nav-cta">
      <a href={links.github} target="_blank" rel="noopener">GitHub ↗</a>
      <div data-show-on="desktop">
        <a class="btn btn-primary" href={links.download}>Download</a>
      </div>
      <div data-show-on="ios">
        <a class="btn btn-primary" href={links.appStore}>Join the beta</a>
      </div>
    </div>
  </div>
</nav>
