---
import KiteSky from "./KiteSky.astro";
import { links, site } from "../config";

interface Props {
  /** Only the bottom row (copyright and links), for content pages such as
      /privacy that don't need the closing call to action. */
  minimal?: boolean;
}

const { minimal = false } = Astro.props;
const currentYear = new Date().getFullYear();
---

<footer class="foot" id={minimal ? undefined : "download"}>
  {
    !minimal && (
      <div class="foot-sky">
        <span class="cloud c1" />
        <span class="cloud c2" />
        <div class="wrap">
          <KiteSky />
          <h2>Hold every string.</h2>
          <div class="hero-actions">
            <a class="btn btn-primary" href={links.download}>Download for Mac</a>
            <a class="btn btn-ghost" href={links.appStore}>Join the iOS beta</a>
          </div>
        </div>
      </div>
    )
  }
  <div class="wrap foot-grid">
    <div>
      © {currentYear} {site.author} · {site.license} · Product names belong to their owners; Thinkite isn't affiliated with them.
    </div>
    <div class="links">
      <a href={links.github} target="_blank" rel="noopener">GitHub</a>
      <a href="/privacy">Privacy</a>
      <a href={`mailto:${links.contactEmail}`}>Contact</a>
    </div>
  </div>
</footer>
