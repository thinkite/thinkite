---
// The app icon: the master kite tile (public/favicon.svg) clipped to the
// macOS corner radius. Size it with width/height on .app-icon.
interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;
---

<span class={`app-icon ${className}`} aria-hidden="true">
  <img src="/favicon.svg" alt="" width="128" height="128" />
</span>
