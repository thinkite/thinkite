---
// Three lines, each under one of the kite's colours.
const beats = [
  { color: "#EE8A57", title: "Start anywhere.", body: "Pick a folder on your Mac, prompt from your phone." },
  { color: "#F6C67D", title: "Answer anywhere.", body: "Questions and approvals land on your phone." },
  { color: "#7A63AC", title: "Steer anywhere.", body: "Redirect a turn while it's still running." },
];
---

<section class="wrap beats" id="features">
  {
    beats.map((beat) => (
      <div class="beat">
        <svg class="mark" viewBox="0 0 360 320" aria-hidden="true">
          <polygon points="57.6,309.6 151.2,0 360,0 360,237.6" fill={beat.color} />
        </svg>
        <h2>{beat.title}</h2>
        <p>{beat.body}</p>
      </div>
    ))
  }
</section>

<p class="wrap strip">
  Encrypted, device to device · Works alongside OpenCode Desktop and the TUI · Needs opencode 2.1+ · <a href="/privacy">Privacy</a>
</p>
