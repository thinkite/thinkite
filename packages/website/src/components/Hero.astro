---
import BrandMark from "./BrandMark.astro";
import Kite from "./Kite.astro";
import { links } from "../config";
---

<!-- The demo film's end card, as a page, with the kite flying above it. -->
<section class="hero">
  <span class="cloud c1"></span>
  <span class="cloud c2"></span>
  <Kite string={260} />
  <div class="wrap">
    <div class="hero-brand">
      <BrandMark />
      <h1>Thinkite</h1>
    </div>
    <p class="hero-tagline">OpenCode on your Mac. <b>In your pocket.</b></p>

    <div class="hero-actions">
      <div data-show-on="desktop">
        <a class="btn btn-primary" href={links.download}>Download for Mac</a>
        <a class="btn btn-ghost" href={links.appStore}>Join the iOS beta</a>
      </div>
      <div data-show-on="ios">
        <a class="btn btn-primary" href={links.appStore}>Join the iOS beta</a>
        <a class="btn btn-ghost" href={links.download}>Get the Mac app</a>
      </div>
      <div data-show-on="android">
        <a class="btn btn-primary" href={links.github} target="_blank" rel="noopener">GitHub</a>
      </div>
    </div>

    <p class="hero-note">
      <span data-show-on="desktop ios">Free and open source · Apple Silicon Mac + iPhone</span>
      <span data-show-on="android">Mac + iPhone only for now.</span>
    </p>
  </div>
</section>
