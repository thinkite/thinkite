---
// The app icon's kite without its tile: the four triangles of the master
// icon (360 grid; spine V–C, crossbar A–B, crossing at X), plus a string
// that falls from the tail vertex V. Decorative only.
interface Props {
  class?: string;
  /** Length of the string below the kite, in viewBox units. */
  string?: number;
}
const { class: className = "", string = 520 } = Astro.props;
const h = 320 + string;
---

<svg
  class={`kite ${className}`}
  viewBox={`-40 -10 420 ${h}`}
  aria-hidden="true"
  xmlns="http://www.w3.org/2000/svg"
>
  <path
    class="kite-string"
    d={`M57.6 309.6 C 20 ${309.6 + string * 0.35}, 110 ${309.6 + string * 0.6}, 40 ${309.6 + string}`}
    fill="none"
  />
  <g class="kite-body">
    <polygon points="57.6,309.6 151.2,0 250.09,112.54" fill="#EE8A57" />
    <polygon points="151.2,0 360,0 250.09,112.54" fill="#F6C67D" />
    <polygon points="360,0 360,237.6 250.09,112.54" fill="#DB6480" />
    <polygon points="57.6,309.6 250.09,112.54 360,237.6" fill="#7A63AC" />
  </g>
</svg>
