---
// The 45 s demo film, served from this site (public/media). It has music,
// so it waits for a tap instead of autoplaying.
---

<div class="wrap film-wrap">
  <div class="film">
    <video
      controls
      playsinline
      preload="none"
      poster="/media/thinkite-demo-poster.jpg"
      aria-label="Thinkite demo: a dark-mode task started on the Mac, answered and steered from an iPhone"
    >
      <source src="/media/thinkite-demo.mp4" type="video/mp4" />
    </video>
  </div>
</div>
