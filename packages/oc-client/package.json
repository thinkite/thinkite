{
  "name": "@thinkite/oc-client",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Framework-agnostic opencode 2 client, reducers and a TanStack Store data layer for Thinkite frontends (desktop + iOS)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./react": {
      "types": "./src/react.ts",
      "default": "./src/react.ts"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@opencode/client": "2.1.3",
    "@tanstack/store": "catalog:",
    "@tanstack/react-store": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "~19.2.0",
    "react": "catalog:"
  },
  "peerDependencies": {
    "react": ">=19"
  }
}
