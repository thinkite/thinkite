{
  "name": "@thinkite/oc-client",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Framework-agnostic opencode v2 client + reducers for Thinkite frontends (desktop now, iOS in stage 3)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "node": "./dist/index.js",
      "default": "./src/index.ts"
    },
    "./tanstack": {
      "types": "./dist/tanstack/index.d.ts",
      "bun": "./src/tanstack/index.ts",
      "node": "./dist/tanstack/index.js",
      "default": "./src/tanstack/index.ts"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@opencode-ai/sdk": "1.18.30",
    "@tanstack/db": "catalog:"
  }
}
