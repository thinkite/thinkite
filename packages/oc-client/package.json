{
  "name": "@thinkite/oc-client",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Framework-agnostic opencode 2 client + reducers + TanStack DB collections for Thinkite frontends (desktop + iOS)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./tanstack": {
      "types": "./src/tanstack/index.ts",
      "default": "./src/tanstack/index.ts"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@opencode/client": "2.0.2",
    "@tanstack/db": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:"
  }
}
