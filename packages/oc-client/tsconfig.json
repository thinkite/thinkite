{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": []
  },
  "include": ["src/**/*", "src/__fixtures__/*.json"],
  "references": [],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.e2e.ts",
    "src/**/*.e2e.test.ts",
    "scripts/**"
  ]
}
