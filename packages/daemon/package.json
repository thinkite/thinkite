{
  "name": "@thinkite/daemon",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Thinkite daemon: pairs phones and carries them to the user's opencode service over iroh",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "thinkite": "./dist/bin/thinkite.js",
    "sidecode": "./dist/bin/thinkite.js"
  },
  "files": [
    "dist",
    "scripts/*.plist"
  ],
  "engines": {
    "node": ">=24"
  },
  "os": [
    "darwin"
  ],
  "scripts": {
    "dev": "bun --watch src/bin/thinkite.ts up",
    "pair": "bun src/bin/thinkite.ts pair",
    "build": "tsc -b tsconfig.json && chmod +x ./dist/bin/thinkite.js",
    "typecheck": "tsc -b tsconfig.json",
    "start": "node ./dist/bin/thinkite.js",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@number0/iroh": "^1.1.0",
    "@opencode/client": "2.2.4",
    "@thinkite/protocol": "workspace:*",
    "p-limit": "^7.3.0",
    "qrcode": "^1.5.4",
    "simple-git": "^3.36.0",
    "valibot": "1.5.0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/qrcode": "^1.5.6",
    "typescript": "^7.0.2"
  }
}
