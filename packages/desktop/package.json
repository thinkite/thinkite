{
  "name": "@thinkite/desktop",
  "productName": "Thinkite",
  "version": "0.4.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Thinkite desktop GUI — Electron + Vite + React 19 + Astryx",
  "author": "thinkite",
  "type": "module",
  "os": [
    "darwin"
  ],
  "scripts": {
    "dev": "vite",
    "dev:static": "vite build && electron .",
    "build": "vite build",
    "package": "bun run --cwd ../protocol build && bun run --cwd ../daemon build && vite build && electron-builder --mac --arm64 --publish never",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json",
    "package:notarize": "set -a; . ./.env.local 2>/dev/null || true; set +a; bun run --cwd ../protocol build && bun run --cwd ../daemon build && vite build && electron-builder --mac --arm64 --publish never",
    "package:publish": "set -a; . ./.env.local 2>/dev/null || true; set +a; bun run --cwd ../protocol build && bun run --cwd ../daemon build && vite build && electron-builder --mac --arm64 --publish always"
  },
  "dependencies": {
    "@lydell/node-pty": "^1.2.0-beta.15",
    "@thinkite/daemon": "workspace:*",
    "@xterm/addon-serialize": "0.15.0-beta.310",
    "@xterm/headless": "6.1.0-beta.313",
    "electron-updater": "^6.8.11",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@astryxdesign/core": "^0.7.4",
    "@astryxdesign/theme-neutral": "^0.7.4",
    "@legendapp/list": "catalog:",
    "@pierre/diffs": "catalog:",
    "@pierre/highlights": "0.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-router": "^1.170.25",
    "@tanstack/react-store": "catalog:",
    "@tanstack/router-plugin": "^1.168.29",
    "@tanstack/store": "catalog:",
    "@thinkite/oc-client": "workspace:*",
    "@thinkite/protocol": "workspace:*",
    "@types/node": "catalog:",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2",
    "@types/react-dom": "^19.2",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.5",
    "@xterm/addon-fit": "0.12.0-beta.311",
    "@xterm/addon-unicode-graphemes": "0.5.0-beta.310",
    "@xterm/xterm": "6.1.0-beta.315",
    "electron": "^45.0.0",
    "electron-builder": "27.0.0-alpha.11",
    "lucide-react": "^1.24.0",
    "qrcode": "^1.5.4",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vite-plugin-electron": "^1.1.2"
  },
  "main": "dist-electron/index.js"
}
