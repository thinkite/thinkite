 @implementation BottomSheetSurfaceComponentView
 
+// Upstream fix eb77ea8 (software-mansion-labs/react-native-bottom-sheet#72, unreleased as of
+// 0.16.2): React Native 0.88 asserts in -[RCTViewComponentView updateProps:oldProps:] when a
+// subclass never seeds `_props`, which crashed the app the first time a sheet surface mounted.
+- (instancetype)initWithFrame:(CGRect)frame
+{
+  if (self = [super initWithFrame:frame]) {
+    const auto &defaultProps = BottomSheetSurfaceViewShadowNode::defaultSharedProps();
+    _props = defaultProps;
+  }
+  return self;
+}
